# Copiar como .env en ~/tecnihardware y cambiar TODOS los valores. No subir este archivo con claves a GitHub.
# Dominio: con la IP pública 129.151.10.20 se puede usar 129-151-10-20.sslip.io (gratis).
DOMINIO=129-151-10-20.sslip.io
IMAGEN=ghcr.io/neidys06/tecnohardwarepcstore:latest
DB_PASS=cambiar-por-una-clave-larga
DB_ROOT_PASS=cambiar-por-otra-clave-larga
# Generar con: openssl rand -hex 32
JWT_SECRETO=cambiar-por-64-caracteres-hex
# Contraseña temporal del primer ingreso de «admin» (el sistema obliga a cambiarla)
ADMIN_CLAVE=Temporal2026
