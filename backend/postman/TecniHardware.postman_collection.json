        "body": {
          "mode": "raw",
          "raw": "{\n  \"idCliente\": \"{{idCliente}}\",\n  \"tipo\": \"Portátil\",\n  \"marcaModelo\": \"HP 240 G8\",\n  \"periodo\": 5\n}"
        }
      },
      "event": [
        {
          "listen": "test",
