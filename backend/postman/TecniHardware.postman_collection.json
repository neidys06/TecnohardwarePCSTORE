    {
      "name": "Órdenes pendientes de autorización",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/ordenes?estado=PENDIENTE_AUTORIZACION",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ordenes"
          ],
          "query": [
            {
              "key": "estado",
              "value": "PENDIENTE_AUTORIZACION"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Todas en el estado pedido', () => pm.response.json().forEach(o => pm.expect(o.estado).to.eql('PENDIENTE_AUTORIZACION')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cerrar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{xsrf}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
